---
import { Image } from 'astro:assets'
import { render, type CollectionEntry } from 'astro:content'

import { FormattedDate, Icon } from 'astro-pure/user'

interface Props {
  post: CollectionEntry<'blog'>
}

const { post } = Astro.props
const { data, id } = post
const { remarkPluginFrontmatter } = await render(post)
---

<li class='post-card'>
  {
    data.heroImage && (
      <Image {...data.heroImage} alt={data.heroImage.alt || data.title} class='card-cover' />
    )
  }
  <div class='card-heading'>
    <h2>
      <a class='post-link' href={`/blog/${id}`} data-astro-prefetch>
        {data.draft && <span class='text-red-500'>(Draft) </span>}{data.title}
      </a>
    </h2>
    <span class='card-arrow' aria-hidden='true'>↗</span>
  </div>
  <p class='card-description'>{data.description}</p>
  {
    data.tags.length > 0 && (
      <ul class='card-tags' aria-label='Tags'>
        {data.tags.map((tag) => (
          <li>
            <a href={`/tags/${tag}`} data-astro-prefetch>
              {tag}
            </a>
          </li>
        ))}
      </ul>
    )
  }
  <div class='card-meta text-muted-foreground'>
    <FormattedDate class='card-date' date={data.updatedDate ?? data.publishDate} />
    <span class='card-reading'
      ><Icon name='time' class='size-3.5' />{remarkPluginFrontmatter.minutesRead}</span
    >
    {
      data.language && (
        <span class='card-language'>
          <Icon name='earth' class='size-3.5' />
          {data.language}
        </span>
      )
    }
  </div>
</li>

<style>
  .post-card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.625rem 1.5rem;
    min-width: 0;
    padding: 1.125rem 1.25rem;
    border: 1px solid var(--weather-edge);
    border-radius: 1.25rem;
    background:
      linear-gradient(135deg, hsl(var(--foreground) / 0.025), transparent 65%),
      var(--weather-surface);
    box-shadow:
      inset 0 1px hsl(var(--foreground) / 0.035),
      var(--weather-shadow);
    backdrop-filter: blur(12px);
    transition:
      border-color 180ms ease,
      box-shadow 180ms ease,
      transform 180ms ease;
  }
  .post-card:hover,
  .post-card:focus-within {
    border-color: hsl(var(--primary) / 0.4);
    box-shadow:
      inset 0 1px hsl(var(--foreground) / 0.05),
      0 12px 32px hsl(220 40% 5% / 0.15);
    transform: translateY(-2px);
  }
  .card-cover {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 8rem;
    object-fit: cover;
    border-radius: 1.25rem 1.25rem 0 0;
    opacity: 0.18;
    mask-image: linear-gradient(to bottom, black, transparent);
    pointer-events: none;
  }
  .card-heading {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 1rem;
  }
  h2 {
    min-width: 0;
    font-size: 1.125rem;
    font-weight: 500;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }
  .post-link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 1.25rem;
  }
  .post-link:focus-visible {
    outline: none;
  }
  .post-link:focus-visible::after {
    outline: 2px solid hsl(var(--primary) / 0.7);
    outline-offset: 4px;
  }
  .card-arrow {
    flex-shrink: 0;
    color: hsl(var(--muted-foreground));
    font-size: 1.25rem;
    line-height: 1.5;
  }
  .card-description {
    position: relative;
    margin: 0;
    color: hsl(var(--muted-foreground));
    font-size: 0.875rem;
    line-height: 1.7;
    overflow-wrap: anywhere;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }
  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    align-items: center;
  }
  .card-tags a {
    position: relative;
    z-index: 1;
    display: block;
    padding: 0.25rem 0.5rem;
    border: 1px solid hsl(var(--primary) / 0.1);
    border-radius: 0.5rem;
    background: hsl(var(--primary) / 0.055);
    color: hsl(var(--muted-foreground));
    font-size: 0.75rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }
  .card-tags a:hover {
    color: hsl(var(--primary));
  }
  .card-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    position: relative;
    pointer-events: none;
    font-size: 0.75rem;
    line-height: 1.5;
  }
  .card-reading,
  .card-language {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }
  @container (min-width: 35rem) {
    .post-card {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      padding-right: 3rem;
    }
    .card-heading {
      grid-column: 1;
      grid-row: 1;
    }
    .card-description {
      grid-column: 1;
      grid-row: 2;
    }
    .card-meta {
      grid-column: 2;
      grid-row: 1;
      justify-content: flex-end;
    }
    .card-tags {
      grid-column: 2;
      grid-row: 2;
      justify-content: flex-end;
      max-width: 15rem;
    }
    .card-arrow {
      position: absolute;
      right: 1.125rem;
      top: 50%;
      transform: translateY(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .post-card {
      transition: none;
    }
    .post-card:hover,
    .post-card:focus-within {
      transform: none;
    }
  }
</style>
