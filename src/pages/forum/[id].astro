---
import { render } from 'astro:content'

import BaseLayout from '@/layouts/BaseLayout.astro'

import { boardDate, boardLabel, getForumTopics } from '../../data/forum'

import '@/assets/styles/forum.css'

export const prerender = true
export async function getStaticPaths() {
  const forumTopics = await getForumTopics()
  return forumTopics.map((topic) => ({ params: { id: topic.id }, props: { topic } }))
}
const { topic } = Astro.props
const { Content, headings } = await render(topic.entry)
const forumTopics = await getForumTopics()
const related = forumTopics.filter((item) => topic.related.includes(item.id))
---

<BaseLayout
  meta={{ title: `${topic.title} · Board`, description: topic.summary }}
  weatherBackground='subtle'
>
  <main class='forum-shell forum-detail'>
    <a class='forum-back' href='/forum'>← All records</a>
    <header id='content-header' class='forum-detail-header animate'>
      <div class='forum-eyebrow'>BOARD / #{topic.number} <span class='demo-badge'>DEMO</span></div>
      <h1>{topic.title}</h1>
      <div class='forum-row-meta'>
        <span class='forum-status' data-status={topic.status}>{boardLabel(topic.status)}</span><span
          class='forum-tag'>{topic.category}</span
        ><time datetime={topic.date}>First discussed {boardDate(topic.date)}</time>
      </div>
    </header>
    <div class='forum-grid'>
      <article id='content' class='forum-record animate'>
        <div class='board-markdown'><Content /></div>
        <p class='forum-small-note'>Updated {boardDate(topic.updatedDate ?? topic.date)}</p>
      </article>
      <aside class='forum-sidebar'>
        <nav class='forum-detail-nav' aria-label='On this page'>
          <h2>On this page</h2>
          {
            headings
              .filter((heading) => heading.depth === 2)
              .map((heading) => <a href={`#${heading.slug}`}>{heading.text}</a>)
          }
        </nav>
        <section class='forum-related'>
          <h2>Related records</h2>{
            related.map((item) => (
              <a href={`/forum/${item.id}`}>
                <span>#{item.number}</span>
                {item.title}
                <span aria-hidden='true'>↗</span>
              </a>
            ))
          }
        </section>
        <section class='forum-note'>
          <h2>Next steps</h2><p>
            Once context, steps, and feedback are complete, the discussion can become a Blog article
            linked to this record.
          </p><a href='/blog'>Read the Blog →</a>
        </section>
      </aside>
    </div>
  </main>
</BaseLayout>
