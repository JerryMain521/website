---
import IndexPage from '@/layouts/IndexPage.astro'

export const prerender = true

// Temporary placeholder: keep this page loading without requesting Board records.
// The records in src/content/board and their detail pages are retained.
---

<IndexPage
  title='Board'
  meta={{
    title: 'Board',
    description: 'Questions, discussion notes, and follow-up from our sports community.'
  }}
>
  <div id='content' class='board-loading animate' aria-busy='true'>
    <p class='board-loading-status' role='status' lang='en'>
      <span class='board-loading-spinner' aria-hidden='true'></span>
      <span>Loading<span aria-hidden='true'>...</span></span>
    </p>
  </div>
</IndexPage>

<style>
  .board-loading {
    display: grid;
    place-items: center;
    min-height: clamp(18rem, 50svh, 32rem);
    padding: 2rem 1rem;
  }

  .board-loading-status {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.875rem;
    line-height: 1.5;
    letter-spacing: 0.025em;
  }

  .board-loading-spinner {
    width: 2rem;
    height: 2rem;
    border: 2px solid hsl(var(--foreground) / 0.12);
    border-top-color: hsl(var(--muted-foreground));
    border-radius: 50%;
    animation: board-loading-spin 0.9s linear infinite;
  }

  @keyframes board-loading-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .board-loading-spinner {
      animation: none;
    }
  }
</style>
