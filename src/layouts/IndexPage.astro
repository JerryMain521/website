---
import type { SiteMeta } from 'astro-pure/types'
import { Button } from 'astro-pure/user'
import BaseLayout from '@/layouts/BaseLayout.astro'

interface Props {
  title: string
  meta: SiteMeta
  subtitle?: string
  description?: string
  back?: string
}

const { title, meta, subtitle, description, back = '/' } = Astro.props
---

<BaseLayout {meta} weatherBackground='subtle'>
  <div class='index-page-shell'>
    <Button title='Back' href={back} variant='back' />
    <main class='index-page-main'>
      <header id='content-header' class='index-page-header animate'>
        <div>
          <h1>{title}{subtitle && <span>{subtitle}</span>}</h1>
          {description && <p>{description}</p>}
        </div>
        <slot name='header-actions' />
      </header>
      <slot />
    </main>
  </div>
</BaseLayout>

<style>
  .index-page-shell {
    max-width: 60rem;
    margin-inline: auto;
  }
  .index-page-main {
    margin-top: 24px;
  }
  .index-page-header {
    display: flex;
    justify-content: space-between;
    align-items: start;
    gap: 20px;
    margin-bottom: 24px;
  }
  h1 {
    font-size: 30px;
    line-height: 1.2;
    font-weight: 500;
  }
  h1 span {
    margin-left: 12px;
    font-size: 13px;
    font-weight: 400;
    color: hsl(var(--muted-foreground));
  }
  p {
    margin-top: 10px;
    font-size: 12px;
    line-height: 1.8;
    color: hsl(var(--muted-foreground));
  }
  @media (min-width: 640px) {
    .index-page-main {
      margin-top: 40px;
    }
  }
  @media (max-width: 600px) {
    h1 span {
      display: block;
      margin: 4px 0 0;
    }
  }
</style>
